# Aexoryn Agent — Environment Variables
# Copyright (c) 2026 Irfan Syazwan / Aexoryn  |  MIT License
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── OpenRouter (primary cloud gateway) ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LiteLLM (optional secondary gateway) ─────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=

# ── Ollama (local models) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Workspace ───────────────────────────────────────────────────────────
# Absolute path to the VS Code workspace Aexoryn will operate on
AEXORYN_WORKSPACE=.

# ── Session ───────────────────────────────────────────────────────────────────
AEXORYN_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
AEXORYN_SESSION_LOG=./logs/session.log
